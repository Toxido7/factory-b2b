{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "mail:test": "node scripts/send-test-email.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:demo": "dotenv -e .env -- node scripts/seed-demo.js",
    "requests:retry-emails": "dotenv -e .env -- node scripts/retry-request-emails.js",
    "tokens:cleanup": "dotenv -e .env -- node scripts/cleanup-tokens.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
